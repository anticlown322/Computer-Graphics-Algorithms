<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:viewModels="clr-namespace:CGA.MVVM.ViewModels"
                    xmlns:shadings="clr-namespace:CGA.Core.Shadings"
                    xmlns:renderers="clr-namespace:CGA.Core.Renderers">
    <!--Images-->
    <BitmapImage x:Key="CloseWindow" UriSource="/CGA;component/Resources/Images/close.png"/>
    <BitmapImage x:Key="MinimizeWindow" UriSource="/CGA;component/Resources/Images/minimize.png"/>
    
    <ObjectDataProvider x:Key="RendererChoicesProvider"
                        MethodName="GetValues"
                        ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="renderers:RendererType" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    
    <ObjectDataProvider x:Key="ShadingChoicesProvider"
                        MethodName="GetValues"
                        ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="shadings:ShadingType" />
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
</ResourceDictionary>